# ==============================================================================
# Alert-Management Backend API - Environment Variables Example
# Copy to a local env file (never commit real secrets).
# ==============================================================================

# --- PostgreSQL (Docker Compose / Migration Owner & Least-Privilege App Role) ---
POSTGRES_DB=alert_manager
POSTGRES_USER=alert_owner
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_OWNER_PASSWORD
POSTGRES_APP_USER=alert_api_app
POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP_PASSWORD

# --- API Database Connection ---
# Production should set sslmode=require
DATABASE_URL=postgres://alert_api_app:CHANGE_ME_POSTGRES_APP_PASSWORD@postgres:5432/alert_manager?sslmode=disable
MIGRATE_DATABASE_URL=postgres://alert_owner:CHANGE_ME_POSTGRES_OWNER_PASSWORD@postgres:5432/alert_manager?sslmode=disable
PG_MAX_CONNS=25
PG_MIN_CONNS=5

# --- HTTP Listeners & Logging ---
PORT=8080
ADMIN_PORT=9090
LOG_LEVEL=info

# --- Grafana Plugin Internal JWT & Legacy Proxy Auth ---
GRAFANA_PLUGIN_JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
GRAFANA_PLUGIN_JWT_SECRET_PREVIOUS=
GRAFANA_PLUGIN_JWT_ISSUER=noc-alert-manager-app
# Production should use HTTPS public URL
GRAFANA_PUBLIC_URL=http://localhost:3000
ALLOW_LEGACY_PROXY_HEADER_AUTH=false
GRAFANA_PROXY_SHARED_TOKEN=

# --- Grafana Local Admin (Docker Compose) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# --- Alertmanager Inbound Webhook ---
ALERTMANAGER_WEBHOOK_TOKEN=CHANGE_ME_ALERTMANAGER_WEBHOOK_TOKEN
ALERTMANAGER_MAX_PAYLOAD_BYTES=5242880

# --- ServiceNow Integration ---
SNOW_INSTANCE_URL=http://mocksnow:8085
SNOW_AUTH_MODE=oauth_client_credentials
SNOW_TOKEN_URL=http://mocksnow:8085/oauth_token.do
SNOW_CLIENT_ID=CHANGE_ME_SNOW_CLIENT_ID
SNOW_CLIENT_SECRET=CHANGE_ME_SNOW_CLIENT_SECRET
SNOW_OAUTH_SCOPE=
SNOW_USERNAME=CHANGE_ME_SNOW_USERNAME
SNOW_PASSWORD=CHANGE_ME_SNOW_PASSWORD

# Generic fallback sys_user sys_id and display username in ServiceNow
SNOW_DEFAULT_NOC_CALLER_SYS_ID=00000000000000000000000000000noc
SNOW_DEFAULT_NOC_CALLER_USERNAME=noc
SNOW_DEFAULT_ASSIGNMENT_GROUP=Infrastructure
SNOW_DEFAULT_CATEGORY=Infrastructure

# ServiceNow Inbound Business Rule Webhook Secret (HMAC-SHA256)
SNOW_INBOUND_WEBHOOK_SECRET=CHANGE_ME_SNOW_INBOUND_WEBHOOK_SECRET

# ServiceNow HTTP & Background Sync Tuning
SNOW_HTTP_TIMEOUT_SECONDS=15
SNOW_POLL_INTERVAL_SECONDS=120
SNOW_AUTO_POST_RESOLVED_NOTE=true
SNOW_NOTE_WORKER_INTERVAL_SECONDS=15
ALLOW_RETROSPECTIVE_INCIDENT_CREATE=false
